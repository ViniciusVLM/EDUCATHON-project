# URL da API (padrão: /api, com o proxy do Vite em desenvolvimento)
# VITE_API_URL=https://api.seudominio.com/api

# Login com Google (Firebase Authentication). Copie do console do Firebase:
# Configurações do projeto → Seus apps → App da Web → firebaseConfig.
# Estes valores são públicos (identificam o projeto, não dão acesso a nada).
# Sem eles, o botão "Entrar com Google" não aparece.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=seu-projeto
# VITE_FIREBASE_APP_ID=
