# Google Gemini API Key (obter em https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo do Gemini a usar. Modelos confirmados em out/2026
# (fonte: https://ai.google.dev/gemini-api/docs/models):
#   gemini-3.8-flash  (recomendado — mais recente, alta inteligencia)
#   gemini-3.5-flash  (estavel, pronto para producao em escala)
GEMINI_MODEL=gemini-3.8-flash

# Modelo reserva (opcional). Acionado caso o modelo principal esgote tentativas com erro 503 ou 429.
# Use um dos modelos citados acima (ex.: gemini-3.5-flash).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Concorrência da fila de processamento de respostas (padrão: 1).
# Evita disparar pedidos em paralelo contra um modelo sobrecarregado.
GEMINI_CONCURRENCY=1

# Chave secreta para assinar tokens JWT (OBRIGATÓRIA).
# ⚠️  NÃO use um valor fixo em produção — quem tiver acesso ao código poderá forjar tokens.
# Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=substitua_por_um_valor_aleatorio_forte_de_64_caracteres

# Configuração de proxy reverso (Render, Railway, etc.).
# Permite que o express-rate-limit identifique o IP real do cliente atrás de proxies.
# Padrão: desligado. Para 1 salto de proxy reverso, use 1:
# TRUST_PROXY=1

# Porta do servidor backend
PORT=3001

# Origens permitidas pelo CORS (separadas por virgula).
# Default: http://localhost:5173,http://127.0.0.1:5173
# Em producao, coloque o dominio real: CORS_ORIGIN=https://educathon.exemplo.com
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

