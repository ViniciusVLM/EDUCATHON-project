# Google Gemini API Key (obter em https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo do Gemini a usar. Exemplos válidos em set/2026:
#   gemini-2.5-flash  (estável, custo baixo — padrão)
#   gemini-3.7-flash  (mais recente, capacidades avançadas)
#   gemini-3.8-flash  (último lançamento, set/2026)
# Consulte https://ai.google.dev/gemini-api/docs/deprecations para atualizar.
GEMINI_MODEL=gemini-2.5-flash

# Chave secreta para assinar tokens JWT (OBRIGATÓRIA).
# ⚠️  NÃO use um valor fixo em produção — quem tiver acesso ao código poderá forjar tokens.
# Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=substitua_por_um_valor_aleatorio_forte_de_64_caracteres

# Porta do servidor backend
PORT=3001

# Origens permitidas pelo CORS (separadas por vírgula).
# Default: http://localhost:5173,http://127.0.0.1:5173
# Em produção, coloque o domínio real: CORS_ORIGIN=https://educathon.exemplo.com
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

